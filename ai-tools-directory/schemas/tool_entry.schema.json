{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-tools.schema.json",
  "title": "AI Tool Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "slug",
    "description",
    "official_url",
    "pricing_model",
    "has_api",
    "categories",
    "languages_supported"
  ],
  "properties": {
    "name": { "type": "string", "minLength": 2 },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "description": { "type": "string", "minLength": 20 },
    "official_url": { "type": "string", "format": "uri" },
    "pricing_model": {
      "type": "string",
      "enum": ["free","paid","freemium","subscription","one_time"]
    },
    "has_api": { "type": "boolean" },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "languages_supported": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z]{2}$" }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "images": { "type": "array", "items": { "type": "string", "format": "uri" } },
        "videos": { "type": "array", "items": { "type": "string", "format": "uri" } }
      }
    },
    "pros": { "type": "array", "items": { "type": "string" } },
    "cons": { "type": "array", "items": { "type": "string" } },
    "popularity_score": { "type": "number", "minimum": 0 },
    "source_citation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title","url"],
        "properties": {
          "title": { "type": "string" },
          "url": { "type": "string", "format": "uri" }
        }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
